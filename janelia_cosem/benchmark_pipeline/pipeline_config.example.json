{
  "models": [
    {
      "name": "SparseSeg",
      "python": "${VEM_PYTHON}",
      "adapter": "model_adapters/run_sparseseg.py",
      "args": ["--variant", "sparseseg"]
    },
    {
      "name": "SparseSeg-ViT",
      "python": "${VEM_PYTHON}",
      "adapter": "model_adapters/run_sparseseg.py",
      "args": ["--variant", "vit"]
    },
    {
      "name": "StarDist",
      "python": "${STARDIST_PYTHON}",
      "adapter": "model_adapters/run_stardist.py",
      "args": []
    },
    {
      "name": "MitoNet sparse-adapted",
      "python": "${MITONET_PYTHON}",
      "adapter": "model_adapters/run_mitonet.py",
      "args": ["--variant", "sparse_adapted",
               "--base-config", "formal_assets/configs/mitonet/MitoNet_v1.yaml",
               "--finetune-template", "formal_assets/configs/mitonet/finetune_config_portable.yaml",
               "--base-model", "${MITONET_MODEL}"]
    },
    {
      "name": "MitoNet-Pretrained",
      "python": "${MITONET_PYTHON}",
      "adapter": "model_adapters/run_mitonet.py",
      "args": ["--variant", "pretrained",
               "--base-config", "formal_assets/configs/mitonet/MitoNet_v1.yaml",
               "--base-model", "${MITONET_MODEL}"]
    },
    {
      "name": "DeePict",
      "python": "${DEEPICT_PYTHON}",
      "adapter": "model_adapters/run_deepict.py",
      "args": ["--deepict-root", "${DEEPICT_ROOT}",
               "--deepict-commit", "4a9662933f7302a5402e025d14bec2205fc8ff96"]
    },
    {
      "name": "COSEM-2D-UNet",
      "python": "${COSEM_UNET_PYTHON}",
      "adapter": "model_adapters/run_cosem_unet.py",
      "args": ["--dimension", "2d"]
    },
    {
      "name": "COSEM-3D-UNet",
      "python": "${COSEM_UNET_PYTHON}",
      "adapter": "model_adapters/run_cosem_unet.py",
      "args": ["--dimension", "3d"]
    },
    {
      "name": "Vanilla-UNet",
      "python": "${VEM_PYTHON}",
      "adapter": "model_adapters/run_sparse_baseline.py",
      "args": ["--variant", "vanilla_unet"]
    },
    {
      "name": "nnU-Net",
      "python": "${NNUNET_PYTHON}",
      "adapter": "model_adapters/run_nnunetv2.py",
      "args": ["--variant", "raw"]
    },
    {
      "name": "Vanilla-UNet-SparseMatched",
      "python": "${VEM_PYTHON}",
      "adapter": "model_adapters/run_sparse_baseline.py",
      "args": ["--variant", "vanilla_unet_sparse_matched"]
    },
    {
      "name": "nnU-Net-SparseMatched",
      "python": "${NNUNET_PYTHON}",
      "adapter": "model_adapters/run_nnunetv2.py",
      "args": ["--variant", "sparse_matched"]
    }
  ]
}
